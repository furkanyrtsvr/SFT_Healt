#include <zephyr/dt-bindings/i2c/i2c.h>
#include <zephyr/dt-bindings/gpio/gpio.h>

/ {
	aliases {
		dht0 = &dht11;
	};

	chosen {
		zephyr,display = &oled;
	};

	zephyr,user {
		/* Encoder A: D8 / P1.04 */
		encoder-a-gpios =
			<&gpio1 4 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;

		/* Encoder B: D9 / P1.06 */
		encoder-b-gpios =
			<&gpio1 6 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;

		/* Encoder butonu: D10 / P0.09, diger uc GND */
		encoder-sw-gpios =
			<&gpio0 9 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;

		/* HX711 PD_SCK: D2 / P0.17 */
		pressure-sck-gpios =
			<&gpio0 17 GPIO_ACTIVE_HIGH>;

		/* HX711 DOUT: D3 / P0.20 */
		pressure-out-gpios =
			<&gpio0 20 GPIO_ACTIVE_HIGH>;

		/* DS1302 CLK: D5 / P0.24 */
		rtc-clk-gpios =
			<&gpio0 24 GPIO_ACTIVE_HIGH>;

		/* DS1302 DATA: D15 / P0.02 */
		rtc-data-gpios =
			<&gpio0 2 GPIO_ACTIVE_HIGH>;

		/* DS1302 RST/CE: D12 / P1.11 */
		rtc-ce-gpios =
			<&gpio1 11 GPIO_ACTIVE_HIGH>;
	};

	dht11: dht11 {
		compatible = "aosong,dht";
		/* DHT11 DATA: D4 / P0.22, 4.7K-10K ile 3V3'e pull-up. */
		dio-gpios =
			<&gpio0 22 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
		status = "okay";
	};
};

&i2c0 {
	status = "okay";
	clock-frequency = <I2C_BITRATE_FAST>;

	oled: ssd1306@3c {
		compatible = "solomon,ssd1306";
		reg = <0x3c>;

		width = <128>;
		height = <64>;

		segment-offset = <0>;
		page-offset = <0>;
		display-offset = <0>;
		multiplex-ratio = <63>;

		segment-remap;
		com-invdir;
		prechargep = <0x22>;
	};
};
